--- !u!114 &1473290255
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1473290248}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6485e5fa0f2c1204ab94cd4ad7fc45ca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  storyUiRoot: {fileID: 9100000000000000010}
  speakerNameText: {fileID: 9100000000000000013}
  dialogueText: {fileID: 9100000000000000015}
  fallbackBackgroundSprite: {fileID: 21300000, guid: 3fb8035378d1f5b49a69f1bd8e0b93ab, type: 3}
  fallbackFontAsset: {fileID: 11400000, guid: 7fa6499f646b5c04c817bb3bd676a826, type: 2}
  mainSceneUI: {fileID: 1473290249}
  mainRoomInteractionController: {fileID: 0}
  hideWhilePlaying: []
  firstDialogueDelay: 0.5
  characterInterval: 0.035
  advanceKeys: 200000000d000000
  phoneDialogue:
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uC5F0\uACB0 \uC0C1\uD0DC\uB97C \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.\n\uC138
      \uBC88\uC9F8 \uADFC\uBB34\uB97C \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uC5B4\uC81C \uD604\uC7A5\uC5D0\uC11C \uC5F4\uB78C\uD55C \uC790\uB8CC\uB294
      \n\uD604\uC7AC \uC0AC\uC6A9\uB418\uC9C0 \uC54A\uB294 \uBCF4\uAD00 \uAE30\uB85D\uC785\uB2C8\uB2E4.\n\uD604\uD589
      \uC5C5\uBB34 \uAE30\uC900\uC73C\uB85C \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uAE30\uB85D\uC5D0 \uB0A8\uC544 \uC788\uB358 \uC778\uC6D0\uC740 \n\uACFC\uAC70\uC758
      \uC784\uC2DC \uAD00\uCE21 \uB2F4\uB2F9\uC790\uC785\uB2C8\uB2E4.\n\uD604\uC7AC
      \uC2DC\uC124\uC5D0 \uB0A8\uC544 \uC788\uB294 \uC778\uC6D0\uC740 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uD574\uB2F9 \uC778\uC6D0\uC758 \uADFC\uBB34\uB294 \uC815\uC0C1\uC801\uC73C\uB85C
      \uC885\uB8CC\uB410\uC2B5\uB2C8\uB2E4.\n\uC77C\uBD80 \uAE30\uB85D\uC774 \uB204\uB77D\uB41C
      \uAC83\uC740 \uD3D0\uC1C4 \uACFC\uC815\uC5D0\uC11C \n\uBC1C\uC0DD\uD55C \uB370\uC774\uD130
      \uC190\uC0C1 \uB54C\uBB38\uC785\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "O-06\uC740 \uD3D0\uAE30\uB41C \uAD6C\uD615 \uAD00\uB9AC \uCF54\uB4DC\uC785\uB2C8\uB2E4.\n\uD604\uC7AC
      \uAD00\uCE21 \uB300\uC0C1\uC774\uB098 \n\uBCF4\uACE0 \uCCB4\uACC4\uC640\uB294
      \uAD00\uACC4\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uC774\uD6C4 \uAC19\uC740 \uD45C\uAE30\uB97C \uBC1C\uACAC\uD558\uB354\uB77C\uB3C4
      \n\uBCC4\uB3C4\uB85C \uBCF4\uACE0\uD560 \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uAD00\uB828
      \uC790\uB8CC\uB294 \uAD00\uB9AC \uCE21\uC5D0\uC11C \uCC98\uB9AC\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uC77C\uBC18 \uAD00\uCE21 \uC5C5\uBB34\uC5D0\uB294 \uBCC0\uACBD \uC0AC\uD56D\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4.\n\uC815\uC0C1 \uBC30\uCE58\uC640 \uB2E4\uB978 \uC0AC\uD56D\uB9CC
      \n\uAE30\uC874 \uC808\uCC28\uC5D0 \uB530\uB77C \uAE30\uB85D\uD558\uC138\uC694."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uD654\uBA74\uC5D0\uC11C \uBC1C\uC0DD\uD558\uB294 \uBCC0\uD654\uC5D0
      \uC758\uBBF8\uB97C \uBD80\uC5EC\uD558\uC9C0 \uB9C8\uC2ED\uC2DC\uC624.\n\uAD00\uCE21
      \uB300\uC0C1\uC740 \uC804\uB2EC\uD560 \uC815\uBCF4\uB97C \uAC00\uC9C4 \uC874\uC7AC\uAC00
      \uC544\uB2C8\uB77C \n\uCC98\uB9AC\uD574\uC57C \uD560 \uC624\uB958\uC785\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uCD94\uAC00 \uD604\uC7A5 \uC5C5\uBB34\uAC00 \uC804\uB2EC\uB418\uB354\uB77C\uB3C4
      \n\uC9C0\uC815\uB41C \uC124\uBE44\uB9CC \uD655\uC778\uD558\uC2ED\uC2DC\uC624.\n\uBCF4\uAD00
      \uAE30\uB85D\uC5D0 \uB2E4\uC2DC \uC811\uADFC\uD558\uB294 \uD589\uC704\uB294
      \uD5C8\uAC00\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uC774\uC804 \uADFC\uBB34\uC790\uC758 \uAE30\uB85D\uC740 \uB2F9\uC2E0\uC758
      \uC5C5\uBB34\uC640 \uAD00\uACC4\uC5C6\uC2B5\uB2C8\uB2E4.\n\uAD00\uCE21\uC744
      \uC2DC\uC791\uD558\uC2ED\uC2DC\uC624."
