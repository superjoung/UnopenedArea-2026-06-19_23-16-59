--- !u!114 &2489251691472513186
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4049524125100115639}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6485e5fa0f2c1204ab94cd4ad7fc45ca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  storyUiRoot: {fileID: 2379043747029488630}
  speakerNameText: {fileID: 3787402302827370862}
  dialogueText: {fileID: 4348033836821820290}
  fallbackBackgroundSprite: {fileID: 0}
  fallbackFontAsset: {fileID: 0}
  mainSceneUI: {fileID: 5925089524056581342}
  mainRoomInteractionController: {fileID: 0}
  hideWhilePlaying:
  - {fileID: 6973313081690132307}
  firstDialogueDelay: 0.5
  characterInterval: 0.035
  advanceKeys: 200000000d000000
  phoneDialogue:
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uC2DC\uC124\uC740 \uD604\uC7AC \uC6B4\uC601\uC744 \uC911\uB2E8\uD55C
      \uC0C1\uD0DC\uC785\uB2C8\uB2E4.\n\uB0B4\uBD80\uC5D0 \uC2B9\uC778\uB41C \uC0C1\uC8FC
      \uC778\uC6D0\uC740 \uC5C6\uC73C\uBA70, \n\uD5C8\uAC00\uB41C \uAD6C\uC5ED\uB9CC
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uC5C5\uBB34\uB294 \uAC04\uB2E8\uD569\uB2C8\uB2E4.\n\uBA3C\uC800 \uAC01
      \uAD6C\uC5ED\uC758 \uC815\uC0C1 \uBC30\uCE58\uB97C \uD655\uC778\uD558\uACE0,
      \n\uC774\uD6C4 CCTV \uD654\uBA74\uACFC \uBE44\uAD50\uD558\uC138\uC694."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uAE30\uC900\uACFC \uB2E4\uB978 \uC0AC\uD56D\uC744 \uBC1C\uACAC\uD558\uBA74
      \n\uC774\uC0C1\uC774 \uBC1C\uC0DD\uD55C \uAD6C\uC5ED, \uB300\uC0C1, \uBCC0\uD654
      \uC720\uD615\uC744 \n\uAE30\uB85D\uD558\uBA74 \uB429\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uC815\uD655\uD55C \uAE30\uB85D\uC774 \uC811\uC218\uB418\uBA74 \uC2DC\uC124\uC758
      \uC790\uB3D9 \uAD50\uC815 \uC808\uCC28\uAC00 \uC2E4\uD589\uB429\uB2C8\uB2E4.\n\uCC98\uB9AC
      \uC911 \uD654\uBA74\uC5D0 \uC7A1\uC74C\uC774 \uC0DD\uAE38 \uC218 \uC788\uC9C0\uB9CC
      \uC815\uC0C1\uC785\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uD655\uC2E0\uD560 \uC218 \uC5C6\uB2E4\uBA74 \uC11C\uB458\uB7EC \uAE30\uB85D\uD558\uC9C0
      \uB9C8\uC138\uC694.\n\uB2E4\uB978 \uCC44\uB110\uC744 \uD655\uC778\uD55C \uB4A4
      \uB2E4\uC2DC \uD310\uB2E8\uD574\uB3C4 \uB429\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uC804\uB825\uC774\uB098 \uC11C\uBC84 \uAC19\uC740 \uC124\uBE44 \uBB38\uC81C\uB294
      \uC790\uB3D9\uC73C\uB85C \uCC98\uB9AC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uD544\uC694\uD55C
      \uACBD\uC6B0 \uBCC4\uB3C4\uC758 \uD604\uC7A5 \uC5C5\uBB34\uB97C \uC804\uB2EC\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uD604\uC7A5 \uC5C5\uBB34\uB294 \uC9C0\uC815\uB41C \uACBD\uB85C\uC5D0\uC11C\uB9CC
      \uC9C4\uD589\uD558\uC138\uC694.\n\uD655\uC778\uC774 \uB05D\uB098\uBA74 \uACE7\uBC14\uB85C
      \uC81C\uC5B4\uC2E4\uB85C \uBCF5\uADC0\uD558\uBA74 \uB429\uB2C8\uB2E4."
  - speakerName: "\uAD00\uB9AC\uAD00"
    dialogue: "\uC9C0\uAE08\uC740 \uAC01 \uAD6C\uC5ED\uC758 \uC815\uC0C1 \uC0C1\uD0DC\uB97C
      \uAE30\uC5B5\uD558\uB294 \uB370 \uC9D1\uC911\uD558\uC138\uC694. \n\uC900\uBE44\uAC00
      \uB05D\uB098\uBA74 \uCCAB \uAD00\uCE21\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
